<view class="wrap">
  <view class="topbar">
    <view class="dot {{model.source==='live'?'on':'off'}}"></view>
    <text>{{model.statusText}}</text>
    <text class="fx">{{model.fxText}}</text>
  </view>

  <view wx:if="{{model.qualityText}}" class="card notecard">{{model.qualityText}}</view>
  <view wx:if="{{model.errorMsg}}" class="card errcard">{{model.errorMsg}}</view>

  <view wx:if="{{model.loading}}" class="card"><text class="muted">加载中…</text></view>

  <block wx:else>
    <view class="card">
      <view class="k">股票总资产（可投资金 + 持仓市值）</view>
      <view class="v">{{model.tc}} <text class="unit">万</text></view>
      <view class="rowline">
        <text>可投资金 {{model.inv}} 万</text>
        <text>持仓市值 {{model.mv}} 万</text>
      </view>
      <view class="rowline">
        <text class="{{model.plCls}}">浮盈亏 {{model.pl}} 万（{{model.plPct}}%）</text>
        <text>税后年股息 {{model.curDiv}} 万/年</text>
      </view>
      <view wx:if="{{model.plNote}}" class="s">{{model.plNote}}</view>
    </view>

    <view class="chips">
      <view class="sigchip {{model.nOver?'red':''}}">
        <view class="k">仓位预警（最优先）</view>
        <view class="n">{{model.nOver}}</view>
        <view class="s">{{model.overNames}}</view>
      </view>
      <view class="sigchip {{model.nTrig?'green':''}}">
        <view class="k">已触发·可进流程</view>
        <view class="n">{{model.nTrig}}</view>
        <view class="s">{{model.trigNames}}</view>
      </view>
      <view class="sigchip {{model.nNear?'amber':''}}">
        <view class="k">接近（≤+5%）</view>
        <view class="n">{{model.nNear}}</view>
        <view class="s">{{model.nearNames}}</view>
      </view>
      <view class="sigchip">
        <view class="k">投放进度</view>
        <view class="n">{{model.deployPct}}%</view>
        <view class="s">未投 {{model.uninvested}} 万 · 等待也是纪律</view>
      </view>
    </view>

    <!-- 郎刚10-25晚：首页=观察清单（原第四页签内容），替代信号清单；分类筛选与原观察页同源 -->
    <view class="card" wx:if="{{model.watch.rows.length}}">
      <view class="k">观察清单（点按展开策略）</view>
      <view class="filters">
        <text wx:for="{{model.watch.filters}}" wx:key="key" class="fbtn {{model.watch.filter===item.key?'on':''}}"
              data-f="{{item.key}}" bindtap="setFilter">{{item.label}} {{item.count}}</text>
      </view>
      <view class="filterhint">{{model.watch.filterHint}}</view>
      <view class="wrow" wx:for="{{model.watch.rows}}" wx:key="code" data-code="{{item.code}}" bindtap="toggle">
        <view class="line1">
          <text class="b">{{item.name}}</text>
          <text class="pill {{item.grade}}">{{item.grade}}</text>
          <text wx:if="{{item.held}}" class="pill hold">持仓</text>
          <text wx:if="{{item.bcls}}" class="badge {{item.bcls}}" style="margin-left:auto">{{item.status}}</text>
          <text wx:else class="pill wait" style="margin-left:auto">{{item.status}}</text>
        </view>
        <view class="line2">
          <text class="px">{{item.px}}</text>
          <text class="muted"> {{item.cur}}</text>
          <text class="{{item.pctCls}}" style="margin-left:18rpx">{{item.pctTxt}}</text>
          <text class="muted" style="margin-left:auto">距参考 {{item.dist}}</text>
        </view>
        <view class="pills">
          <text wx:for="{{item.tiers}}" wx:for-item="p" wx:key="label"
                class="pill {{p.cls}}">{{p.label}} {{p.price}}{{p.unit}}{{p.mark}}{{p.amt?'·'+p.amt:''}}</text>
        </view>
        <view wx:if="{{item.expanded}}" class="planbox">
          <view>{{item.plan}}</view>
          <view>持有逻辑：{{item.summary.thesis}}</view>
          <view>证伪条件：{{item.summary.breakers}}</view>
          <view>下次复核：{{item.summary.reviewBy}}</view>
        </view>
      </view>
    </view>
    <view class="card" wx:else><text class="muted">观察清单暂无可展示标的。</text></view>

    <view class="card notecard">⚠️ 统一提醒：到价 ≠ 下单。任何行动前先按 v3.4 刷新前三步数据，再走第四步组合决策；H股另须满足 A/H 双门槛（折价≥25%）。价格触发后不倒计时、不催促，等待本身是纪律的一部分。档位后 ≤金额 为该档累计建仓上限（按规划本金折算）。</view>
  </block>
</view>
