/* 一次性播种：把本地config.json推入云数据库（替换探测行） */
const { createWorkBuddyCloud } = require('@tencent-ai/workbuddy-cloud-sdk');
const pc = require('./publicConfig.json');
const cfg = require('./config.json');
const cloud = createWorkBuddyCloud({ endpoint: pc.endpoint, publishableKey: pc.publishableKey });
(async () => {
  const r = await cloud.database.from('app_config').upsert({ key:'config', data:cfg }).select();
  if (r.error) { console.error('ERROR', JSON.stringify(r.error)); process.exit(1); }
  console.log('播种OK: holdings=' + cfg.holdings.length + ' universe=' + cfg.universe.length);
  process.exit(0);
})();
